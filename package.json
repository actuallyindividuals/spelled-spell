{
  "name": "@spelled/spell",
  "version": "0.1.1",
  "description": "How a spell draws and plays: the canvas (fill / stanza / flow), the movie clock, and the spell CSS from spelled.dev.",
  "license": "MIT",
  "author": "Peter B Smith <hello@peterbsmith.com>",
  "homepage": "https://github.com/actuallyindividuals/spelled-spell#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/actuallyindividuals/spelled-spell.git"
  },
  "bugs": "https://github.com/actuallyindividuals/spelled-spell/issues",
  "keywords": ["spelled", "writing", "typing", "replay", "timeline", "keystrokes"],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/spell.js",
  "jsdelivr": "./dist/spell.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./spell.css": "./dist/spell.css",
    "./spell.js": "./dist/spell.js",
    "./package.json": "./package.json"
  },
  "sideEffects": ["*.css"],
  "files": ["dist", "src"],
  "scripts": {
    "build": "node build.cjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
